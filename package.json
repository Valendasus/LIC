{
  "name": "lic",
  "version": "0.1.0",
  "private": true,
  "description": "LIC — Learn, Implement, Confirm. Личная платформа для обучения разработке.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "content:check": "node scripts/check-content.mjs",
    "content:run": "node scripts/run-output.mjs",
    "new:topic": "node scripts/new-topic.mjs",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run content:check && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "lucide-react": "1.61.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "ts-fsrs": "6.0.0",
    "ts6": "npm:typescript@6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "18.0.9",
    "jsdom": "31.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
